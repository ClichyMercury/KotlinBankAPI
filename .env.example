# --- Server ---
PORT=8080
ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_DB=finsim
POSTGRES_USER=finsim
POSTGRES_PASSWORD=finsim_dev
DATABASE_URL=jdbc:postgresql://localhost:5434/finsim
DATABASE_USER=finsim
DATABASE_PASSWORD=finsim_dev

# --- Redis ---
REDIS_URL=redis://localhost:6380

# --- JWT ---
JWT_SECRET=change-me-in-production-this-must-be-very-long-and-random
JWT_ISSUER=finsim-api
JWT_AUDIENCE=finsim-clients
JWT_REALM=finsim
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30
PASSWORD_RESET_EXPIRATION_MINUTES=30

# --- Mail (reset password) ---
MAIL_PROVIDER=log                    # log (dev, token dans les logs) | resend (prod)
RESEND_API_KEY=                      # re_... , obligatoire si MAIL_PROVIDER=resend
MAIL_FROM=FinSim <no-reply@tondomaine.com>   # domaine vérifié chez Resend
PASSWORD_RESET_URL=https://finsim.app/reset-password?token={token}

# --- Market data (J4) ---
COINGECKO_API_KEY=
